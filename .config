# This is an empty file, please overwrite it after generating the .config file with the source code
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7620=y
CONFIG_TARGET_ramips_mt7620_DEVICE_hiwifi_hc5861=y
CONFIG_PACKAGE_kmod-phy-realtek=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_wpad-basic-wolfssl=y
CONFIG_PACKAGE_luci=y

CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_kmod-wireguard=y
# ===== 解 no such package：kmod 全部编进固件（体积小，必做）=====
CONFIG_PACKAGE_kmod-tun=y            # sing-box/momo 建 TUN 必需
CONFIG_PACKAGE_kmod-inet-diag=y      # sing-box 依赖
CONFIG_PACKAGE_kmod-dummy=y          # momo 依赖
CONFIG_PACKAGE_kmod-nft-tproxy=y     # 透明代理要
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-nat=y

# ===== 顺带把上轮的 ip 冲突也一起解了 =====
CONFIG_PACKAGE_ip-full=y
# CONFIG_PACKAGE_ip-tiny is not set
# 不要选 Docker/大插件，16MB 放不下
